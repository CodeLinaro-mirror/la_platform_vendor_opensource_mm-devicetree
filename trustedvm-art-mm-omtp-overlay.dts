/dts-v1/;
/plugin/;

#include "hfi_core/trustedvm-art-hfi-core.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. Art MTP - TrustedVM";
	compatible = "qcom,art-mtp", "qcom,art", "qcom,artp-cdp", "qcom,artp",
		"qcom,mtp";
	qcom,msm-id = <707 0x10000>, <707 0x20000>, <708 0x10000>, <708 0x20000>;
	qcom,board-id = <0x10031 0>;
};
